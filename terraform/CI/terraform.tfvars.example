aws_region       = "ap-south-1"
project_name     = "stockmind"
instance_type    = "m7i-flex.large"
ami_image        = "ami-0b6d9d3d33ba97d99"

# Use an existing EC2 key pair.
key_name = "YOUR_KEY_PAIR_NAME" # Key_Pair For Our EC2 instance so Terraform can Make Files

# Example: your public IP/32.
# allowed_ssh_cidr = "YOUR_PUBLIC_IP/32"



